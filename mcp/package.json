{
  "name": "sho-el-zbde-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that submits voice notes to a running Sho el Zbde instance and reads back the digest",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sho-el-zbde-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
