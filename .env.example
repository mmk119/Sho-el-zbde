# ---------------------------------------------------------------------------
# Sho el Zbde — environment template
# Copy to .env and fill in. Never commit .env.
#
# No variable in this project ever carries a VITE_ prefix. Vite inlines those
# into the browser bundle; this app has no Vite frontend and no key belongs
# anywhere near one.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME="Sho el Zbde"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Database — SQLite, a single file, no server to install.
# Upgrade path: set DB_CONNECTION=mysql and fill the block below. Nothing in
# the app code assumes SQLite.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=

# Only read when DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Queue — Laravel's database driver, so there is no Redis to run.
# Upgrade path: QUEUE_CONNECTION=redis plus a REDIS_* block. The jobs do not
# care which driver carries them.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=file

# ---------------------------------------------------------------------------
# Progress updates — the result page polls the GET endpoint.
# Upgrade path: Reverb broadcasting, with polling staying as the fallback.
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=null
POLL_INTERVAL_SECONDS=3

# --- Filesystem ---
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Transcription (TranscriptionService binding)
# driver: openai | whispercpp
# ---------------------------------------------------------------------------
TRANSCRIPTION_DRIVER=openai
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT=600

# Per-minute list price used for usage_logs.cost_estimate. Config rather than a
# constant so a price change is not a code change.
TRANSCRIPTION_COST_PER_MINUTE_USD=0.006

# Prompts are keyed by language, because a Whisper prompt is a LANGUAGE signal
# as much as a vocabulary hint - an Arabic prompt makes it translate English
# speech into Arabic. TRANSCRIPTION_PROMPT is the neutral one used for auto
# detect; keep it short. TRANSCRIPTION_PROMPT_AR is the Lebanese vocabulary and
# is only used when the uploader actually selects Arabic.
# Leave both blank to use the built-in defaults from config/shoelzbde.php.
TRANSCRIPTION_PROMPT=
TRANSCRIPTION_PROMPT_AR=

# OpenAI-hosted Whisper
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Self-hosted whisper.cpp (swap-in target — not wired up yet)
WHISPERCPP_BINARY=
WHISPERCPP_MODEL_PATH=

# ---------------------------------------------------------------------------
# Analysis (AnalysisService binding)
# ---------------------------------------------------------------------------
# driver: openai
# Settled in Phase 3. The interface and the driver switch are provider-agnostic;
# adding another vendor is a new class plus a match arm, not a rewrite.
ANALYSIS_DRIVER=openai
ANALYSIS_MODEL=gpt-4o
ANALYSIS_TIMEOUT=180

# Analysis is billed per token, not per minute of audio, which is why
# usage_logs records the two pipeline steps separately.
ANALYSIS_COST_PER_MILLION_INPUT_USD=2.50
ANALYSIS_COST_PER_MILLION_OUTPUT_USD=10.00

# --- Audio pipeline ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_TARGET_CHANNELS=1
AUDIO_SILENCE_DURATION=1.5
AUDIO_SILENCE_THRESHOLD=-40dB
AUDIO_NORMALIZE_TIMEOUT=300

# --- Limits and retention ---
# Both limits are enforced on the ORIGINAL upload, before NormalizeAudio runs.
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=1200
RETENTION_DAYS=30
# Per IP, per hour, for anonymous uploads. Set to 0 to turn the limit off.
ANON_UPLOADS_PER_HOUR=5
